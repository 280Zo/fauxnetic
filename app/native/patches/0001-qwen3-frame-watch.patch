+// Qwen3-TTS: a callback run after each generated frame with its codebook-0 code; non-zero stops the
+// line and crispasr_session_synthesize returns nullptr. Pass nullptr to clear. rc -2 for other backends.
+CA_EXPORT int crispasr_session_set_tts_frame_watch(crispasr_session* s, int (*cb)(int, int32_t, void*), void* ud) {
+    if (!s)
+        return -1;
+#ifdef CA_HAVE_QWEN3_TTS
+    if (s->qwen3_tts_ctx) {
+        qwen3_tts_set_frame_watch((qwen3_tts_context*)s->qwen3_tts_ctx, cb, ud);
+        return 0;
+    }
+#endif
+    (void)cb;
+    (void)ud;
+    return -2;
+}
+
+// Qwen3-TTS: why the last line ended (1 end of speech, 2 frame limit, 3 KV ceiling, 4 stopped by
+// the frame watch); 0 for other backends.
+CA_EXPORT int crispasr_session_last_tts_stop_reason(crispasr_session* s) {
+#ifdef CA_HAVE_QWEN3_TTS
+    if (s && s->qwen3_tts_ctx)
+        return qwen3_tts_last_stop_reason((qwen3_tts_context*)s->qwen3_tts_ctx);
+#endif
+    (void)s;
+    return 0;
+}
+
