+// Called after each generated frame of qwen3_tts_synthesize with the frame's codebook-0 code; a
+// non-zero return stops the line. While a watch is set, a line that doesn't end on its own (stopped
+// by the watch, or at the frame limit or KV ceiling) returns nullptr without being decoded.
+// Lets a caller end a line that has gone wrong (e.g. silence that never turns into speech).
+typedef int (*qwen3_tts_frame_watch)(int frame, int32_t cb0, void* user_data);
+void qwen3_tts_set_frame_watch(struct qwen3_tts_context* ctx, qwen3_tts_frame_watch cb, void* user_data);
+
+// Why the last line ended: 1 end of speech, 2 frame limit, 3 KV ceiling, 4 stopped by a frame watch
+// or streaming callback, other values for early failures.
+int qwen3_tts_last_stop_reason(struct qwen3_tts_context* ctx);
